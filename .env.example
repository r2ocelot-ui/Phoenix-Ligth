# Copy to .env and adjust. All variables are prefixed with PHOENIX_.

# --- MQTT broker ---
PHOENIX_MQTT_HOST=localhost
PHOENIX_MQTT_PORT=1883
# PHOENIX_MQTT_USERNAME=
# PHOENIX_MQTT_PASSWORD=

# --- Database ---
# SQLite for the prototype; use postgresql+psycopg://user:pass@host/db in prod.
PHOENIX_DATABASE_URL=sqlite:///./phoenix.db

# --- Auth / JWT ---
# CHANGE THIS in any non-local deployment.
PHOENIX_JWT_SECRET=dev-secret-change-me
PHOENIX_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Cierra sesión en el panel tras N minutos sin actividad.
PHOENIX_SESSION_IDLE_MINUTES=10

# --- Rank progression ---
# If true, users auto-promote one step when eligible, capped at the max rank.
PHOENIX_AUTO_PROMOTE_ENABLED=false
PHOENIX_AUTO_PROMOTE_MAX_RANK=tecnico

# --- Demo ---
# Seeds synthetic telemetry + a known owner account. Turn OFF in production.
PHOENIX_DEMO_MODE=true
PHOENIX_DEMO_ADMIN_USERNAME=phoenix
PHOENIX_DEMO_ADMIN_PASSWORD=phoenix123

# --- Tarifa eléctrica (dimming por coste) ---
# Off por defecto. La zona horaria es la del despliegue (los tramos son en
# hora civil local, no la del servidor que suele ir en UTC).
PHOENIX_TARIFF_ENABLED=false
PHOENIX_TARIFF_FLOOR_LEVEL=40
# Zona de la TARIFA (tramos punta/valle). En España es peninsular por ley,
# también para Canarias. No la confundas con la del reloj.
PHOENIX_TARIFF_TIMEZONE=Europe/Madrid
# Zona de DISPLAY (reloj y tiempos del panel). "auto" la deduce de la
# ubicación de los cuadros (Canarias → Atlantic/Canary; resto → Europe/Madrid).
# O fíjala a mano: Europe/Madrid, Atlantic/Canary, etc.
PHOENIX_DISPLAY_TIMEZONE=auto

# --- Licencia (anti-copia on-premise, Ed25519) ---
# Off por defecto (modo abierto). Para activarla: pon la pública del titular
# y la licencia firmada que se emite con tools/make_license.py.
PHOENIX_LICENSE_REQUIRED=false
# PHOENIX_LICENSE_PUBLIC_KEY=<clave-publica-ed25519-base64>
# PHOENIX_LICENSE_KEY=<licencia-firmada>

# --- API ---
# Comma-separated list, or ["*"]. Tighten for production.
# PHOENIX_CORS_ORIGINS=["https://panel.example.com"]
